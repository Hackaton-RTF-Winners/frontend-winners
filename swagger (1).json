{
  "openapi": "3.0.1",
  "info": {
    "title": "Mercatus API",
    "description": "All-in-one service for Mercatus platform",
    "version": "v1"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "MercatusApi"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/nomenclatures": {
      "get": {
        "tags": [
          "Nomenclatures"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NomenclaturesCollectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nomenclatures/{id}": {
      "get": {
        "tags": [
          "Nomenclatures"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NomenclatureResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrdersCollectionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/create": {
      "post": {
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "required": [
          "contact",
          "first_name",
          "inn",
          "last_name",
          "nomenclature_id",
          "phone"
        ],
        "type": "object",
        "properties": {
          "nomenclature_id": {
            "type": "string",
            "format": "uuid"
          },
          "first_name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "last_name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          },
          "phone": {
            "minLength": 1,
            "pattern": "^[1-9][0-9]{7,14}$",
            "type": "string"
          },
          "inn": {
            "maxLength": 12,
            "minLength": 10,
            "pattern": "^\\d{10}|\\d{12}$",
            "type": "string"
          },
          "contact": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "required": [
          "ok"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "default": false
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NomenclatureRecord": {
        "required": [
          "category_id",
          "classifier",
          "created_at",
          "diameter",
          "form_of_length",
          "gost",
          "id",
          "koef",
          "manufacturer",
          "name",
          "pipe_type_id",
          "pipe_wall_thickness",
          "production_type",
          "status",
          "steel_grade"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "pipe_type_id": {
            "type": "string",
            "format": "uuid"
          },
          "classifier": {
            "type": "string",
            "nullable": true
          },
          "production_type": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "gost": {
            "type": "string",
            "nullable": true
          },
          "form_of_length": {
            "type": "string",
            "nullable": true
          },
          "manufacturer": {
            "type": "string",
            "nullable": true
          },
          "steel_grade": {
            "type": "string",
            "nullable": true
          },
          "diameter": {
            "type": "number",
            "format": "double"
          },
          "pipe_wall_thickness": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "type": "boolean"
          },
          "koef": {
            "type": "number",
            "format": "double"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "NomenclatureResponse": {
        "required": [
          "ok"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "default": false
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "nullable": true
          },
          "nomenclature": {
            "$ref": "#/components/schemas/NomenclatureRecord"
          }
        },
        "additionalProperties": false
      },
      "NomenclaturesCollectionResponse": {
        "required": [
          "ok",
          "page_id",
          "page_size",
          "total_elements",
          "total_pages"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "default": false
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "nullable": true
          },
          "page_id": {
            "type": "integer",
            "format": "int32"
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "total_elements": {
            "type": "integer",
            "format": "int32"
          },
          "total_pages": {
            "type": "integer",
            "format": "int32"
          },
          "nomenclatures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NomenclatureRecord"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderRecord": {
        "required": [
          "created_at",
          "first_name",
          "id",
          "inn",
          "last_name",
          "phone",
          "price_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "price_id": {
            "type": "string",
            "format": "uuid"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "inn": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderResponse": {
        "required": [
          "ok"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "default": false
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "nullable": true
          },
          "order": {
            "$ref": "#/components/schemas/OrderRecord"
          }
        },
        "additionalProperties": false
      },
      "OrdersCollectionResponse": {
        "required": [
          "ok",
          "page_id",
          "page_size",
          "total_elements",
          "total_pages"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "default": false
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "validation_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "nullable": true
          },
          "page_id": {
            "type": "integer",
            "format": "int32"
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "total_elements": {
            "type": "integer",
            "format": "int32"
          },
          "total_pages": {
            "type": "integer",
            "format": "int32"
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderRecord"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValidationError": {
        "required": [
          "field",
          "message"
        ],
        "type": "object",
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}